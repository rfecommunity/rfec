# Canonical site URL — used for metadata, OG tags, sitemap and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://recifefrontend.com.br

# --- Sanity (Events Module) ---
# Public values are safe to expose to the browser bundle.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Pin the API version (YYYY-MM-DD). Bump deliberately.
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01

# Server-only. Read token used for draft/preview content. Never expose to the client.
SANITY_API_READ_TOKEN=

# Server-only. Shared secret used to verify Sanity webhook signatures hitting /api/revalidate.
SANITY_REVALIDATE_SECRET=
